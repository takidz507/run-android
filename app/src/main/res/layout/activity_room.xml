<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootRoomFrame"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/run_bg">

    <!-- #17: Synced Per-Room Identity Pattern & Color Wash Canvas -->
    <com.takidz.run.ui.views.RoomPatternBackgroundView
        android:id="@+id/roomPatternBackground"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <LinearLayout
        android:id="@+id/rootRoomLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent"
        android:orientation="vertical">

        <!-- ================= DESIGN A AIRY ROOM HEADER (Matches Right Phone in 7196.png) ================= -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/topBarCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@android:color/transparent"
            app:cardCornerRadius="0dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="16dp"
                android:paddingEnd="20dp"
                android:paddingBottom="8dp">

                <!-- Row 1: Back + Title (with overlapping lime highlighter) & Subtitle on start; ⋮ + Room Orb 'S' on end -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/btnBack"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_arrow_back"
                        app:tint="@color/run_text" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">

                        <!-- Room Title with Overlapping Lime Marker Bar (Matches 7196.png: "Study Group D5") -->
                        <FrameLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <View
                                android:id="@+id/viewRoomTitleHighlighter"
                                android:layout_width="148dp"
                                android:layout_height="9dp"
                                android:layout_gravity="bottom|start"
                                android:layout_marginBottom="2dp" />

                            <TextView
                                android:id="@+id/tvRoomTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:paddingEnd="4dp"
                                android:text="Study Group D5"
                                android:textColor="@color/run_text"
                                android:textSize="20sp"
                                android:textStyle="bold" />
                        </FrameLayout>

                        <!-- Subtitle: "12 online · 48 messages" + Timed Mute Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvRoomSyncStatus"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:maxLines="1"
                                android:singleLine="true"
                                android:text="1 online · 0 messages"
                                android:textColor="@color/run_muted"
                                android:textSize="12.5sp" />

                            <TextView
                                android:id="@+id/tvRoomMuteStatusPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:background="@drawable/bg_pill_neutral"
                                android:paddingStart="6dp"
                                android:paddingTop="1dp"
                                android:paddingEnd="6dp"
                                android:paddingBottom="1dp"
                                android:text="🔕 Muted"
                                android:textColor="@color/run_muted"
                                android:textSize="10.5sp"
                                android:visibility="gone"
                                android:clickable="true"
                                android:focusable="true" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Hidden legacy header controls (accessible via ⋮ Room More sheet so header stays clean like 7196.png) -->
                    <TextView
                        android:id="@+id/tvRoomCodeBadge"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone" />

                    <ImageButton
                        android:id="@+id/btnRoomIdentity"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:contentDescription="Room Identity" />

                    <ImageButton
                        android:id="@+id/btnMuteRoom"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:contentDescription="Mute" />

                    <ImageButton
                        android:id="@+id/btnShareRoom"
                        android:layout_width="1dp"
                        android:layout_height="1dp"
                        android:visibility="gone"
                        android:contentDescription="Share" />

                    <!-- ⋮ Room More Button (opens sheet with Identity, Share Invite, Copy Code, Mute, Archive, Leave/Delete) -->
                    <ImageButton
                        android:id="@+id/btnDeleteRoom"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginEnd="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Room Options"
                        android:src="@drawable/ic_more_vert"
                        app:tint="@color/run_text" />

                    <!-- Circular Lime Room Initials Orb on Top-Right ('S' in 7196.png) -->
                    <TextView
                        android:id="@+id/tvRoomHeaderOrb"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:gravity="center"
                        android:text="S"
                        android:textColor="@color/run_accent_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- Row 2: Three Separate Pill Tabs (Chat · Tasks · Notes) matching 7196.png -->
                <LinearLayout
                    android:id="@+id/layoutRoomTabsBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabChat"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="68dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Chat"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabTasks"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:minWidth="68dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Tasks"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnTabNotes"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:minWidth="68dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:paddingStart="18dp"
                        android:paddingEnd="18dp"
                        android:text="Notes"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:cornerRadius="18dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ================= ADAPTIVE CONTENT AREA (#16 Phone Single-Pane & Tablet Two-Pane) ================= -->
        <LinearLayout
            android:id="@+id/layoutAdaptiveRoomBody"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal">

            <!-- ================= 1. CHAT PANEL ================= -->
            <LinearLayout
                android:id="@+id/chatPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- #18: First-Use Discoverable Gesture Hint Banner -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardGestureHintBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="12dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="8dp"
                        android:paddingBottom="6dp">

                        <TextView
                            android:id="@+id/tvGestureHintText"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/gesture_hint_banner"
                            android:textColor="@color/run_muted"
                            android:textSize="11sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnDismissGestureHint"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="28dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:text="@string/got_it"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Messages List with Floating Scroll-To-Bottom Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvMessages"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clipToPadding="false"
                        android:overScrollMode="never"
                        android:paddingStart="16dp"
                        android:paddingTop="4dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="8dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnScrollToBottom"
                        style="@style/Widget.Material3.Button.ElevatedButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_alignParentBottom="true"
                        android:layout_centerHorizontal="true"
                        android:layout_marginBottom="10dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:text="New Messages ↓"
                        android:textSize="11.5sp"
                        android:visibility="gone"
                        app:cornerRadius="18dp" />
                </RelativeLayout>

                <!-- Inline Tasks Preview Strip in Chat (Matches Design A 7196.png: "[✓] Revise Analysis ch.2") -->
                <LinearLayout
                    android:id="@+id/layoutInlineTasksPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="20dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="6dp"
                    android:visibility="gone" />

                <!-- Typing indicator banner -->
                <TextView
                    android:id="@+id/tvTypingIndicator"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingStart="22dp"
                    android:paddingTop="2dp"
                    android:paddingEnd="22dp"
                    android:paddingBottom="2dp"
                    android:textColor="@color/run_muted"
                    android:textSize="11.5sp"
                    android:textStyle="italic"
                    android:visibility="gone" />

                <!-- Voice recording live countdown banner -->
                <TextView
                    android:id="@+id/tvRecordingTimerBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="#2d1519"
                    android:gravity="center"
                    android:padding="8dp"
                    android:textColor="@color/run_danger"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <!-- Quoted reply preview banner -->
                <LinearLayout
                    android:id="@+id/replyBanner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_reply_box"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="6dp"
                    android:padding="8dp"
                    android:visibility="gone">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="22dp"
                        android:background="@color/run_accent" />

                    <TextView
                        android:id="@+id/tvReplyingToText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textColor="@color/run_text"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/btnCancelReply"
                        android:layout_width="26dp"
                        android:layout_height="26dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Cancel reply"
                        android:src="@drawable/ic_close"
                        app:tint="@color/run_muted" />
                </LinearLayout>

                <!-- Slim Stadium Pill Composer Bar (Matches Bottom of Right Phone in 7196.png) -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardComposerBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="18dp"
                    android:layout_marginEnd="18dp"
                    android:layout_marginBottom="14dp"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="26dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="8dp"
                        android:paddingTop="3dp"
                        android:paddingEnd="6dp"
                        android:paddingBottom="3dp">

                        <ImageButton
                            android:id="@+id/btnAttachFile"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Attach file"
                            android:src="@drawable/ic_attach_file"
                            app:tint="@color/run_muted" />

                        <EditText
                            android:id="@+id/etMessageInput"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="2dp"
                            android:layout_marginEnd="2dp"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="Write a message..."
                            android:maxLines="4"
                            android:paddingStart="6dp"
                            android:paddingTop="10dp"
                            android:paddingEnd="6dp"
                            android:paddingBottom="10dp"
                            android:textColor="@color/run_text"
                            android:textColorHint="@color/run_subtle"
                            android:textSize="14.5sp" />

                        <ImageButton
                            android:id="@+id/btnRecordVoice"
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Record voice"
                            android:src="@drawable/ic_mic"
                            app:tint="@color/run_muted" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSendMessage"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:insetTop="0dp"
                            android:insetBottom="0dp"
                            android:padding="0dp"
                            app:cornerRadius="19dp"
                            app:icon="@drawable/ic_send"
                            app:iconGravity="textStart"
                            app:iconPadding="0dp"
                            app:iconSize="18dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>

            <!-- ================= 2. TASKS PANEL ================= -->
            <LinearLayout
                android:id="@+id/tasksPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/progressHeaderCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="14dp">

                        <com.takidz.run.ui.views.TaskProgressRingView
                            android:id="@+id/progressRingView"
                            android:layout_width="58dp"
                            android:layout_height="58dp"
                            android:layout_marginEnd="14dp" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvTasksSummaryTitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="0 of 0 completed"
                                android:textColor="@color/run_text"
                                android:textSize="15.5sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTasksSummarySub"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Shared checklist for everyone in this room"
                                android:textColor="@color/run_muted"
                                android:textSize="12sp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etNewTaskInput"
                        android:layout_width="0dp"
                        android:layout_height="44dp"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_input_field"
                        android:hint="@string/add_task_hint"
                        android:paddingStart="14dp"
                        android:paddingEnd="14dp"
                        android:singleLine="true"
                        android:textColor="@color/run_text"
                        android:textColorHint="@color/run_subtle"
                        android:textSize="14sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnAddTask"
                        style="@style/Widget.Material3.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="44dp"
                        app:cornerRadius="16dp"
                        app:icon="@drawable/ic_add"
                        android:text="Add" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTasks"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:paddingBottom="16dp" />
            </LinearLayout>

            <!-- ================= 3. SHARED NOTES PANEL ================= -->
            <LinearLayout
                android:id="@+id/notesPanel"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="8dp"
                android:paddingEnd="20dp"
                android:paddingBottom="16dp"
                android:visibility="gone">

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardNotesPaper"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="22dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginBottom="10dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:src="@drawable/ic_note"
                                app:tint="@color/run_text"
                                android:contentDescription="Notes" />

                            <TextView
                                android:id="@+id/tvNoteStatus"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="8dp"
                                android:layout_weight="1"
                                android:text="Shared paper • Synced with room"
                                android:textColor="@color/run_muted"
                                android:textSize="12sp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnNoteSync"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:insetTop="0dp"
                                android:insetBottom="0dp"
                                android:paddingStart="10dp"
                                android:paddingEnd="10dp"
                                android:textSize="11sp"
                                app:icon="@drawable/ic_sync"
                                app:iconSize="12dp"
                                android:text="Sync" />
                        </LinearLayout>

                        <HorizontalScrollView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:scrollbars="none"
                            android:layout_marginBottom="10dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal">

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoteBullet"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="• Bullet"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoteCheck"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="[ ] Task"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoteHeading"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:text="# Heading"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoteCopy"
                                    style="@style/Widget.Material3.Button.TonalButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    app:icon="@drawable/ic_content_copy"
                                    app:iconSize="12dp"
                                    android:text="Copy"
                                    android:textSize="11sp" />

                                <com.google.android.material.button.MaterialButton
                                    android:id="@+id/btnNoteClear"
                                    style="@style/Widget.Material3.Button.TextButton"
                                    android:layout_width="wrap_content"
                                    android:layout_height="32dp"
                                    android:layout_marginStart="6dp"
                                    android:insetTop="0dp"
                                    android:insetBottom="0dp"
                                    android:textColor="@color/run_danger"
                                    android:text="Clear"
                                    android:textSize="11sp" />
                            </LinearLayout>
                        </HorizontalScrollView>

                        <EditText
                            android:id="@+id/etSharedNoteContent"
                            android:layout_width="match_parent"
                            android:layout_height="0dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_paper_note"
                            android:gravity="top|start"
                            android:hint="@string/notes_placeholder"
                            android:lineSpacingExtra="4dp"
                            android:padding="14dp"
                            android:textColor="@color/run_text"
                            android:textColorHint="@color/run_subtle"
                            android:textSize="14.5sp" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:layout_marginTop="8dp">

                            <TextView
                                android:id="@+id/tvNoteWordCount"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="0 words • 0 characters"
                                android:textColor="@color/run_muted"
                                android:textSize="11sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Real-time synced"
                                android:textColor="@color/run_muted"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
