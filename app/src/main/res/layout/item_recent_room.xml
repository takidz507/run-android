<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRecentRoomItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="22dp"
    app:cardElevation="0dp"
    app:strokeWidth="1dp"
    app:strokeColor="@color/run_panel_hover"
    app:cardBackgroundColor="@color/run_panel"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="15dp"
        android:paddingEnd="18dp"
        android:paddingBottom="15dp">

        <!-- Hidden legacy orb reference kept for ID compatibility -->
        <TextView
            android:id="@+id/tvRoomInitialsOrb"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone" />

        <!-- Line 1: Room Title + Single-Line Unbreakable Code/Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecentRoomName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:text="Study Group D5"
                android:textColor="@color/run_text"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRecentRoomTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:maxLines="1"
                android:singleLine="true"
                android:text="#ABC123"
                android:textColor="@color/run_subtle"
                android:textSize="11.5sp" />
        </LinearLayout>

        <!-- Line 2: Last Message / Activity Subtitle (Matches Design A 7196.png) -->
        <TextView
            android:id="@+id/tvRecentRoomPreview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="Salim: I uploaded the TD solutions"
            android:textColor="@color/run_muted"
            android:textSize="13.5sp" />

        <!-- Line 3: Single Clean Lime Pill Badge (Never wraps or breaks) -->
        <LinearLayout
            android:id="@+id/layoutRoomBadgesRow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRecentRoomCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="none"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="10dp"
                android:paddingTop="3dp"
                android:paddingEnd="10dp"
                android:paddingBottom="3dp"
                android:text="● 1 online"
                android:textColor="@color/run_accent_ink"
                android:textSize="11.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvRoomMutedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:maxLines="1"
                android:singleLine="true"
                android:paddingStart="8dp"
                android:paddingTop="3dp"
                android:paddingEnd="8dp"
                android:paddingBottom="3dp"
                android:text="🔕 Muted"
                android:textColor="@color/run_muted"
                android:textSize="11sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Hidden legacy action buttons kept for ID compatibility (actions live on long-press sheet) -->
        <ImageButton
            android:id="@+id/btnCopyRecentCode"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="Copy code" />

        <ImageButton
            android:id="@+id/btnArchiveRecent"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="Archive room" />

        <ImageButton
            android:id="@+id/btnDeleteRecent"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="gone"
            android:contentDescription="Remove room" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
