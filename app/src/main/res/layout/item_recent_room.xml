<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardRecentRoomItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp"
    app:strokeColor="@color/run_panel_hover"
    app:cardBackgroundColor="@color/run_panel"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- #17: Room Identity Initials Orb tinted with room's custom accent color -->
        <TextView
            android:id="@+id/tvRoomInitialsOrb"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_brand_logo"
            android:gravity="center"
            android:text="D5"
            android:textColor="@color/run_accent_ink"
            android:textSize="16sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Title + Muted Badge (#27) + Time -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecentRoomName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Study Group D5"
                    android:textColor="@color/run_text"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRecentRoomTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Just now"
                    android:textColor="@color/run_subtle"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Last Message Preview -->
            <TextView
                android:id="@+id/tvRecentRoomPreview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Tap to enter this live space"
                android:textColor="@color/run_muted"
                android:textSize="13sp" />

            <!-- Bottom Badges Row (Lime Code Pill + Timed Mute Pill #27 + Archive Badge) -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRecentRoomCode"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:background="@drawable/bg_pill_accent"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:text="● #ABC123"
                    android:textColor="@color/run_accent_ink"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRoomMutedBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_pill_neutral"
                    android:paddingStart="8dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="8dp"
                    android:paddingBottom="3dp"
                    android:text="🔕 Muted"
                    android:textColor="@color/run_muted"
                    android:textSize="11sp"
                    android:visibility="gone" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="6dp">

            <ImageButton
                android:id="@+id/btnCopyRecentCode"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Copy code"
                android:src="@drawable/ic_content_copy"
                app:tint="@color/run_muted" />

            <ImageButton
                android:id="@+id/btnArchiveRecent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Archive room"
                android:src="@drawable/ic_archive"
                app:tint="@color/run_muted" />

            <ImageButton
                android:id="@+id/btnDeleteRecent"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Remove room"
                android:src="@drawable/ic_close"
                app:tint="@color/run_subtle" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
