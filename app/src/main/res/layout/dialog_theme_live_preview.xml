<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/scrollSettingsSheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/run_bg"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/layoutSettingsContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSettingsSheetTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Settings"
                    android:textColor="@color/run_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvSettingsSheetSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Appearance · Theme · Profile · Preferences"
                    android:textColor="@color/run_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseSettingsSheet"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close"
                android:src="@drawable/ic_close"
                app:tint="@color/run_text" />
        </LinearLayout>

        <!-- #22: LIVE REAL UI SURFACE PREVIEW (Matches themes-all-four.png) -->
        <TextView
            android:id="@+id/tvLivePreviewSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="LIVE THEME PREVIEW"
            android:textColor="@color/run_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLivePreviewSurface"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/run_bg"
            app:cardCornerRadius="26dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Mini Header inside Live Surface -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvPreviewRunLogo"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Run."
                            android:textColor="@color/run_text"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <View
                            android:id="@+id/viewPreviewHighlighter"
                            android:layout_width="96dp"
                            android:layout_height="6dp"
                            android:layout_marginTop="3dp"
                            android:background="@drawable/bg_highlighter_bar" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvPreviewAvatarOrb"
                        android:layout_width="34dp"
                        android:layout_height="34dp"
                        android:background="@drawable/bg_brand_logo"
                        android:gravity="center"
                        android:text="T"
                        android:textColor="@color/run_accent_ink"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Mini Room Card inside Live Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreviewRoom"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="10dp"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="18dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvPreviewRoomTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Study Group D5"
                            android:textColor="@color/run_text"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewRoomSub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Salim: I uploaded the TD solutions"
                            android:textColor="@color/run_muted"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvPreviewOnlinePill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:background="@drawable/bg_pill_accent"
                            android:paddingStart="8dp"
                            android:paddingTop="2dp"
                            android:paddingEnd="8dp"
                            android:paddingBottom="2dp"
                            android:text="● 12 online"
                            android:textColor="@color/run_accent_ink"
                            android:textSize="10sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Incoming Message Bubble inside Live Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreviewIncomingBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="42dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvPreviewIncomingAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Salim"
                            android:textColor="@color/run_text"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewIncomingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Same warm paper soul, day or night ✨"
                            android:textColor="@color/run_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Outgoing Message Bubble inside Live Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreviewOutgoingBubble"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginStart="42dp"
                    android:layout_marginBottom="8dp"
                    app:cardBackgroundColor="@color/run_own_bubble"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_accent"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="10dp">

                        <TextView
                            android:id="@+id/tvPreviewOutgoingAuthor"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="You"
                            android:textColor="@color/run_accent_ink"
                            android:textSize="11sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvPreviewOutgoingText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="And the lime still glows ✓✓"
                            android:textColor="@color/run_accent_ink"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Interactive Task Row inside Live Surface -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardPreviewTask"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:cardBackgroundColor="@color/run_panel"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/run_panel_hover"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="8dp">

                        <CheckBox
                            android:id="@+id/cbPreviewTask"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                        <TextView
                            android:id="@+id/tvPreviewTaskText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:text="Revise Analysis ch.2"
                            android:textColor="@color/run_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- #14 & #22: THE 4 APPROVED SWITCHABLE THEMES -->
        <TextView
            android:id="@+id/tvThemeSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="CHOOSE THEME (TAP TO PREVIEW LIVE)"
            android:textColor="@color/run_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Theme 1: Warm Paper -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeWarmPaper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:background="#F5F1E6" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="32dp"
                    android:background="#B5E53E" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThemeName1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warm Paper"
                        android:textColor="@color/run_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeDesc1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light · the original, warmer"
                        android:textColor="@color/run_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThemeCheck1"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_brand_logo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1A2407"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme 2: Warm Paper Dark -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeWarmPaperDark"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:background="#181713" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="32dp"
                    android:background="#BCEB4B" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThemeName2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Warm Paper Dark"
                        android:textColor="@color/run_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeDesc2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dark · same soul, at night"
                        android:textColor="@color/run_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThemeCheck2"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_brand_logo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1A2407"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme 3: Clean Air -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeCleanAir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:background="#FFFFFF" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="32dp"
                    android:background="#8AD834" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThemeName3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clean Air"
                        android:textColor="@color/run_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeDesc3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Light · minimal and airy"
                        android:textColor="@color/run_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThemeCheck3"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_brand_logo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1A2407"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Theme 4: Deep Night -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeDeepNight"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:background="#060805" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="32dp"
                    android:background="#C6FF33" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThemeName4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Deep Night"
                        android:textColor="@color/run_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeDesc4"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="AMOLED · neon lime"
                        android:textColor="@color/run_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThemeCheck4"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_brand_logo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1A2407"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>


        <!-- Theme 5: Liquid Glass (v3.1) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardThemeGlass"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1.5dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="12dp">

                <View
                    android:layout_width="44dp"
                    android:layout_height="32dp"
                    android:background="#0E2A26" />

                <View
                    android:layout_width="16dp"
                    android:layout_height="32dp"
                    android:background="#9ADBE8" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvThemeName5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Liquid Glass"
                        android:textColor="@color/run_text"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvThemeDesc5"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Frosted glass · liquid translucency"
                        android:textColor="@color/run_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvThemeCheck5"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="@drawable/bg_brand_logo"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="#1A2407"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Profile Section -->
        <TextView
            android:id="@+id/tvProfileSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="YOUR PROFILE"
            android:textColor="@color/run_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnChangeAvatar"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Choose Avatar Photo"
                android:textSize="12sp"
                app:cornerRadius="14dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenPairingFromSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:text="Link Web / New Phone"
                android:textSize="12sp"
                app:icon="@drawable/ic_phonelink"
                app:iconSize="15dp"
                app:cornerRadius="14dp" />
        </LinearLayout>

        <EditText
            android:id="@+id/etSettingsDisplayName"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_input_field"
            android:hint="Your display name"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/run_text"
            android:textColorHint="@color/run_subtle"
            android:textSize="14sp" />

        <EditText
            android:id="@+id/etSettingsBio"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_input_field"
            android:hint="Short bio or status (optional)"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:singleLine="true"
            android:textColor="@color/run_text"
            android:textColorHint="@color/run_subtle"
            android:textSize="14sp" />

        <!-- #28: Full Arabic Mode & Language Switcher -->
        <TextView
            android:id="@+id/tvLanguageSectionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:text="LANGUAGE &amp; EXPERIENCE"
            android:textColor="@color/run_muted"
            android:textSize="11sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_pill_neutral"
            android:orientation="horizontal"
            android:padding="3dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLangEnglish"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="English (Default)"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnLangArabic"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="العربية (وضع كامل RTL)"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- #20: Light Sound & Vibration Touches Toggle -->
        <CheckBox
            android:id="@+id/cbTouchFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Light sound &amp; vibration touches on send/receive"
            android:textColor="@color/run_text"
            android:textSize="13sp" />

        <!-- #21: Lite Mode for Weak Devices -->
        <CheckBox
            android:id="@+id/cbLiteMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Lite mode (reduce heavy animations for battery/weak devices)"
            android:textColor="@color/run_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbDarkModeVariant"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Dark mode — works with every design above"
            android:textColor="@color/run_text"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/tvLiteModeAutoInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginBottom="8dp"
            android:text="Auto-detection active"
            android:textColor="@color/run_muted"
            android:textSize="11sp" />

        <!-- Notifications & Auto-translate toggles -->
        <CheckBox
            android:id="@+id/cbNotificationsEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Enable room &amp; invite notifications"
            android:textColor="@color/run_text"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/cbAutoTranslateEnabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:text="Auto-translate incoming messages"
            android:textColor="@color/run_text"
            android:textSize="13sp" />

        <!-- #22: Obvious Apply / Cancel Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="end">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCancelSettings"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="Cancel"
                app:cornerRadius="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplySettings"
                style="@style/Widget.Material3.Button"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="10dp"
                android:layout_weight="1"
                android:text="Apply &amp; Save"
                android:textStyle="bold"
                app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
