<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingVertical="4dp">

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/bubbleCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="6dp"
        app:cardBackgroundColor="@color/run_panel"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="@color/run_panel_hover"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="160dp"
            android:maxWidth="320dp"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Header: Avatar + Author + Timestamp -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="4dp">

                <ImageView
                    android:id="@+id/ivAuthorAvatar"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginEnd="6dp"
                    android:scaleType="centerCrop"
                    android:visibility="gone"
                    android:contentDescription="Avatar" />

                <TextView
                    android:id="@+id/tvAuthor"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="User"
                    android:textColor="@color/run_accent"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="14:20"
                    android:textColor="@color/run_subtle"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Quoted Reply Container (Clickable to jump to original message) -->
            <LinearLayout
                android:id="@+id/replyContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:background="@drawable/bg_reply_box"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvReplyAuthor"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/run_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReplyText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:textColor="@color/run_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Attached Image (Clickable for Fullscreen viewer) -->
            <ImageView
                android:id="@+id/ivAttachmentImage"
                android:layout_width="240dp"
                android:layout_height="180dp"
                android:layout_marginBottom="6dp"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:visibility="gone"
                android:contentDescription="Attachment" />

            <!-- Voice Note Player -->
            <LinearLayout
                android:id="@+id/voiceContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:layout_marginBottom="6dp"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPlayVoice"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:paddingStart="10dp"
                    android:paddingEnd="12dp"
                    app:icon="@drawable/ic_play_arrow"
                    app:iconSize="14dp"
                    android:text="Play"
                    android:textSize="12sp"
                    app:cornerRadius="12dp" />

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="0s"
                    android:textColor="@color/run_muted"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- External File / Video Link Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenExternalFile"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                app:icon="@drawable/ic_attach_file"
                app:iconSize="14dp"
                android:text="Open Attachment"
                android:textSize="12sp"
                android:visibility="gone" />

            <!-- Message Text / Caption -->
            <TextView
                android:id="@+id/tvMessageText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:autoLink="web"
                android:text="Hello everyone"
                android:textColor="@color/run_text"
                android:textSize="14sp" />

            <!-- Footer Actions: Reply & Translate -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="end"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnReply"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="4dp"
                    android:text="↩ Reply"
                    android:textColor="@color/run_muted"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/btnTranslate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:padding="4dp"
                    android:text="Translate"
                    android:textColor="@color/run_accent"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</LinearLayout>
