<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/run_bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_brand_logo"
                android:gravity="center"
                android:text="R"
                android:textColor="@color/run_accent_ink"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="run"
                    android:textColor="@color/run_text"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvOnlineStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="● 1 متصل الآن (Synced)"
                    android:textColor="@color/run_accent"
                    android:textSize="12sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnThemeSettings"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="42dp"
                android:text="⚙ المظهر"
                android:textColor="@color/run_text"
                android:textSize="13sp"
                app:cornerRadius="12dp"
                app:strokeColor="@color/run_panel_hover" />
        </LinearLayout>

        <!-- Main Room Creation & Join Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/mainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="22dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="مساحة تعاون ودردشة لحظية فورية"
                    android:textColor="@color/run_text"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="18dp"
                    android:text="أنشئ غرفة خاصة أو عامة في ثوانٍ بدون تسجيل حساب، وشارك المهام والملفات والصوتيات مباشرة."
                    android:textColor="@color/run_muted"
                    android:textSize="13sp" />

                <!-- User Name Field -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسمك المستعار (Your name)"
                    android:textColor="@color/run_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etUserName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="مثال: تقي الدين"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/run_text"
                    android:textColorHint="@color/run_subtle"
                    android:textSize="15sp"
                    android:layout_marginBottom="14dp" />

                <!-- Fixed Room Name Field (Was missing in Web UI!) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="اسم الغرفة (اختياري — Add a room name)"
                    android:textColor="@color/run_muted"
                    android:textSize="12sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="مثال: مراجعة الفيزياء أو مشروع التخرج"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/run_text"
                    android:textColorHint="@color/run_subtle"
                    android:textSize="15sp"
                    android:layout_marginBottom="12dp" />

                <!-- Public Group Option -->
                <CheckBox
                    android:id="@+id/cbPublicGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="إدراج كمجموعة عامة في الدليل (List as public group)"
                    android:textColor="@color/run_text"
                    android:textSize="13sp" />

                <EditText
                    android:id="@+id/etPublicPassword"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_input_field"
                    android:hint="🔒 كلمة مرور للمجموعة العامة (اختياري)"
                    android:inputType="textPassword"
                    android:paddingHorizontal="14dp"
                    android:singleLine="true"
                    android:textColor="@color/run_text"
                    android:textColorHint="@color/run_subtle"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <!-- Primary Action Buttons Integrated Directly Inside Main Card -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCreateRoom"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginEnd="8dp"
                        android:backgroundTint="@color/run_accent"
                        android:text="+ إنشاء غرفة"
                        android:textColor="@color/run_accent_ink"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnJoinByCode"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="0dp"
                        android:layout_height="54dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="# الانضمام بكود"
                        android:textColor="@color/run_accent"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        app:cornerRadius="14dp"
                        app:strokeColor="@color/run_accent"
                        app:strokeWidth="1.5dp" />
                </LinearLayout>

                <!-- Browse Public Groups Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBrowsePublicGroups"
                    style="@style/Widget.MaterialComponents.Button.TextButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:text="🌐 تصفح المجموعات العامة النشطة (0)"
                    android:textColor="@color/run_purple"
                    android:textSize="14sp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Recent Rooms Card (Pick up where you left off) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/recentRoomsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:cardBackgroundColor="@color/run_panel"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="@color/run_panel_hover"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <TextView
                    android:id="@+id/tvRecentTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🕒 أكمل من حيث توقفت (Recent Rooms)"
                    android:textColor="@color/run_muted"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupRecentRooms"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="8dp"
                    app:chipSpacingVertical="6dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
