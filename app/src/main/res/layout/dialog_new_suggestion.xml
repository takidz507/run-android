<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171821"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#f4f3f8"
        android:textSize="18sp"
        android:textStyle="bold"
        android:text="New Community Suggestion" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#9b9dac"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:text="Your idea will be published to the public feedback board." />

    <!-- Category selector -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#f4f3f8"
        android:textSize="13sp"
        android:textStyle="bold"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="6dp"
        android:text="Category:" />

    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbars="none">

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategory"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:singleSelection="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatIdea"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="💡 Idea"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatFeature"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚡ Feature" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatBug"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🐞 Bug" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipCatImprovement"
                style="@style/Widget.Material3.Chip.Filter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🛠 Improvement" />
        </com.google.android.material.chip.ChipGroup>
    </HorizontalScrollView>

    <!-- Title input -->
    <EditText
        android:id="@+id/etSuggestionTitle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        android:background="@drawable/bg_input_field"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:hint="Suggestion title (e.g. Add custom colors)"
        android:textColorHint="#747786"
        android:textColor="#f4f3f8"
        android:textSize="14sp"
        android:singleLine="true" />

    <!-- Description input -->
    <EditText
        android:id="@+id/etSuggestionContent"
        android:layout_width="match_parent"
        android:layout_height="100dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_input_field"
        android:gravity="top|start"
        android:padding="14dp"
        android:hint="Explain why this would help or how it should work..."
        android:textColorHint="#747786"
        android:textColor="#f4f3f8"
        android:textSize="14sp" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCancelSuggestion"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:text="Cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSubmitSuggestion"
            style="@style/Widget.Material3.Button"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            app:cornerRadius="12dp"
            android:text="Post Suggestion" />
    </LinearLayout>
</LinearLayout>
